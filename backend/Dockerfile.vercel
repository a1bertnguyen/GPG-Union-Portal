FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN apk add --no-cache socat
COPY --from=build /app/target/union-portal-0.0.1-SNAPSHOT.jar app.jar
COPY vercel-entrypoint.sh /app/vercel-entrypoint.sh
RUN sed -i 's/\r$//' /app/vercel-entrypoint.sh && chmod +x /app/vercel-entrypoint.sh
ENV SERVER_PORT=8080
EXPOSE 80
CMD ["/app/vercel-entrypoint.sh"]
